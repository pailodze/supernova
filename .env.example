# Copy to .env.local for development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED for pre-registration. The `applications` table holds personal ID
# numbers, so it has RLS enabled with no policies — the anon key above is public
# in the browser and deliberately cannot read it. Only this key can.
# Supabase → Project Settings → API → service_role. Never expose it client-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- SMS (sender.ge) ------------------------------------------------------
SMS_API_KEY=

# --- Discord --------------------------------------------------------------
# Simplest: one shared invite link. Every applicant gets the same one.
DISCORD_INVITE_URL=

# Better: a bot mints a single-use, 7-day invite per applicant, so a leaked link
# can't be passed around. Needs the "Create Invite" permission on that channel.
# Takes priority over the URL above, which then acts as a fallback.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
